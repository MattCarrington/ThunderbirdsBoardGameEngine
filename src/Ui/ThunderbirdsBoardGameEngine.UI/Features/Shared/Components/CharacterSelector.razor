<label for="@CharacterId" class="form-label">
    @CharacterTitle
</label>

<select id="@CharacterId"
        class="form-select"
        value="@SelectedCharacterCode"
        @onchange="OnChanged"
        required>

    <option value="">-- Select a character --</option>

    @foreach (var c in Characters)
    {
        <option value="@c.Key">@c.DisplayName</option>
    }
</select>