<section class="card mb-4"
         aria-labelledby="turn-summary-heading"
         data-testid="turn-summary">

    <div class="card-body">
        <h2 id="turn-summary-heading" class="h4">
            Current Turn
        </h2>

        <p class="fs-5 mb-2"
            data-testid="active-character">
            <strong>
                @Summary.ActiveCharacter.CharacterDisplayName
            </strong>
        </p>

        <p class="mb-0">
            <span class="fw-semibold">Turn order:</span>

            @for (var index = 0;
                  index < Summary.TurnOrder.Count;
                  index++)
            {
                var character = Summary.TurnOrder[index];

                @if (index > 0)
                {
                    <span aria-hidden="true"> → </span>
                }

                <span data-testid="turn-order-character"
                      data-character-code="@character.CharacterCode"
                        class="@(character.CharacterCode ==
                               Summary.ActiveCharacter.CharacterCode
                                   ? "fw-bold text-primary"
                                   : null)">
                    @character.CharacterDisplayName
                </span>
            }
        </p>

        <button type="button"
                class="btn btn-primary"
                data-testid="end-turn"
                disabled="@IsEndingTurn"
                @onclick="() => EndTurnRequested.InvokeAsync()">
            @(IsEndingTurn ? "Ending turn…" : "End Turn")
        </button>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger mt-2"
                 role="alert"
                 data-testid="end-turn-error">
                @ErrorMessage
            </div>
        }
    </div>
</section>